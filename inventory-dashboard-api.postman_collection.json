				{
					"name": "Filter Vehicles With Validation Error",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
									"const response = pm.response.json();",
									"if (response) {",
									"    pm.expect(response.error).to.eql(\"Validation Error\");",
									"    pm.expect(response.success).to.equal(false);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
