	"item": [
		{
			"name": "Vehicle Inventory",
			"item": [
				{
					"name": "Get All Vehicles (Paginated)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
									"const response = pm.response.json();",
									"if (response.data && response.data.length > 0) {",
									"    const aging = response.data.find(v => v.isAging === true);",
									"    const fresh = response.data.find(v => v.isAging === false);",
									"    if (aging) pm.collectionVariables.set('agingVehicleId', aging.id);",
									"    if (fresh) pm.collectionVariables.set('freshVehicleId', fresh.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/vehicles?page=1&limit=3",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"vehicles"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "3"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Filter Aging Vehicles (>90 Days)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
									"const response = pm.response.json();",
									"pm.test('All returned records are aging', function () {",
									"    response.data.forEach(v => pm.expect(v.isAging).to.be.true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/vehicles?isAging=true",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"vehicles"
							],
							"query": [
								{
									"key": "isAging",
									"value": "true"
								}
							]
						}
					},
					"response": []
				},
